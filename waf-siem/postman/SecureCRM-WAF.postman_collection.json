{
  "info": {
    "name": "Secure CRM — WAF + SIEM (Proyecto Final)",
    "description": "Peticiones a traves del WAF (localhost:8080). Carpeta 0: verificacion. Carpeta 1: trafico legitimo (el login guarda el token automaticamente). Carpeta 2: ataques — cada peticion tiene un slot donde pegas el PoC que ya documentaste en el Proyecto DAST. Usa el environment 'SecureCRM-WAF'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Verificacion",
      "item": [
        {
          "name": "Health a traves del WAF (debe dar 200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/health" }
        },
        {
          "name": "Health directo a la app (saltando el WAF)",
          "request": { "method": "GET", "url": "{{base_url_directo}}/api/health" },
          "event": [
            { "listen": "test", "script": { "exec": [
              "// Si esto responde 200, la app sigue expuesta en su puerto original:",
              "// el Red Team puede ir directo sin pasar por el WAF. Es un HALLAZGO.",
              "// Se cierra con la opcion B del README (app como servicio de Docker)."
            ] } }
          ]
        }
      ]
    },
    {
      "name": "1. Trafico legitimo",
      "item": [
        {
          "name": "Login (guarda el token)",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "if (j.token) { pm.environment.set('token', j.token); console.log('token guardado'); }",
              "if (j.user) { console.log('rol:', j.user.role, '| usuario:', j.user.username); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"jperez\",\n  \"password\": \"Password1\"\n}" }
          }
        },
        {
          "name": "Listar tickets (usa el token)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{base_url}}/api/tickets"
          }
        },
        {
          "name": "Buscar tickets (termino normal)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/tickets?q=soporte",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "tickets" ],
              "query": [ { "key": "q", "value": "soporte" } ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Ataques (pega tu PoC del lab DAST)",
      "description": "Con el WAF en On, las peticiones detectadas se bloquean con 403 y se registran. Reemplaza los valores {{poc_...}} por tus PoC y revisa el SIEM. Para DET-05 usa PATCH /api/health, sin modificar datos.",
      "item": [
        {
          "name": "SQLi en el login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{poc_sqli_login}}\",\n  \"password\": \"x\"\n}" }
          }
        },
        {
          "name": "SQLi / XSS en la busqueda de tickets",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/tickets?q={{poc_busqueda}}",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "tickets" ],
              "query": [ { "key": "q", "value": "{{poc_busqueda}}" } ]
            }
          }
        },
        {
          "name": "DET-04 XSS script — regla propia 10022",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{base_url}}/api/tickets?q=%3Cscript%3Ealert%28%27DET04-postman%27%29%3C%2Fscript%3E"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('DET-04: XSS bloqueado', () => pm.response.to.have.status(403));",
              "// En Kibana: DET-04 XSS en WAF y WAF-03 XSS tickets (10022)."
            ] } }
          ]
        },
        {
          "name": "DET-04 XSS javascript — CRS 941",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{base_url}}/api/tickets?q=%3Ca%20href%3Djavascript%3Aalert%28%27DET04-CRS-postman%27%29%3Ex%3C%2Fa%3E"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('DET-04: XSS CRS bloqueado', () => pm.response.to.have.status(403));",
              "// En Kibana: DET-04 XSS en WAF, ruleId 941*."
            ] } }
          ]
        },
        {
          "name": "DET-05 Metodo no permitido (PATCH) — prueba del modo On",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/health?probe=DET05-postman"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('DET-05: PATCH bloqueado por el WAF', () => pm.response.to.have.status(403));",
              "// PATCH no esta en ALLOWED_METHODS; GET /api/health debe responder 200.",
              "// La ruta de salud evita modificar tickets si el WAF esta en DetectionOnly."
            ] } }
          ]
        }
      ]
    }
  ]
}
